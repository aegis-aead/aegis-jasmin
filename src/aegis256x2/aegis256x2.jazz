#[ct = "secret × secret -> secret"]
inline fn update(reg u256[6] st, reg u256 m)
     -> reg u256[6]
{
    reg u256 st5 t;
    st5 = st[5];
    t = st[0] ^ m;
    st[5] = #VAESENC_256(st[4], st5);
    st[4] = #VAESENC_256(st[3], st[4]);
    st[3] = #VAESENC_256(st[2], st[3]);
    st[2] = #VAESENC_256(st[1], st[2]);
    st[1] = #VAESENC_256(st[0], st[1]);
    st[0] = #VAESENC_256(st5, t);

    return st;
}

#[ct = "secret × secret × secret -> secret"]
inline fn update2(reg u256[6] st, reg u256 m, reg u256 st5)
     -> reg u256[6]
{
    reg u256 t = st[0] ^ m;
    st[5] = #VAESENC_256(st[4], st5);
    st[4] = #VAESENC_256(st[3], st[4]);
    st[3] = #VAESENC_256(st[2], st[3]);
    st[2] = #VAESENC_256(st[1], st[2]);
    st[1] = #VAESENC_256(st[0], st[1]);
    st[0] = #VAESENC_256(st5, t);

    return st;
}

#[ct = "secret × secret -> secret"]
inline fn absorb(reg u256[6] st, reg u256 t)
    -> reg u256[6]
{
    st = update(st, t);

    return st;
}

#[ct = "secret × secret -> secret × public"]
inline fn enc(reg u256[6] st, reg u256 t)
    -> reg u256[6], reg u256
{
    reg u256 out mask z st5;
    z = st[1] ^ st[4];
    mask = st[2] & st[3];
    st5 = st[5];
    z ^= mask;
    z ^= st5;
    out = t ^ z;
    #declassify(out);
    st = update2(st, t, st5);

    return st, out;
}

#[ct = "secret × public -> secret × secret"]
inline fn dec(reg u256[6] st, reg u256 t)
    -> reg u256[6], reg u256
{
    reg u256 out mask z st5;
    z = st[1] ^ st[4];
    mask = st[2] & st[3];
    st5 = st[5];
    z ^= mask;
    z ^= st5;
    out = t ^ z;
    st = update2(st, out, st5);

    return st, out;
}

#[ct = "secret × public × public -> secret × secret"]
inline fn declast(reg u256[6] st, reg u256 t,
                  reg u64 left)
    -> reg u256[6], reg u256
{
    reg u256 out mask z st5;
    z = st[1] ^ st[4];
    mask = st[2] & st[3];
    st5 = st[5];
    z ^= mask;
    z ^= st5;
    out = t ^ z;

    stack u256[1] pad;
    pad[0] = out;
    reg u64 i = left;
    while (i < 32) {
        pad[:u8 i] = 0;
        i += 1;
    }
    st = update2(st, pad[0], st5);

    return st, out;
}

#[ct = "public × public -> secret"]
inline fn init(reg u64 key_p, reg u64 nonce_p)
    -> reg u256[6]
{
    global u256 c0 c1;
    c0 = (32u8)[0x62, 0x79, 0xe9, 0x90, 0x59, 0x37, 0x22, 0x15, 0x0d, 0x08, 0x05, 0x03, 0x02, 0x01, 0x01, 0x00,
                0x62, 0x79, 0xe9, 0x90, 0x59, 0x37, 0x22, 0x15, 0x0d, 0x08, 0x05, 0x03, 0x02, 0x01, 0x01, 0x00];
    c1 = (32u8)[0xdd, 0x28, 0xb5, 0x73, 0x42, 0x31, 0x11, 0x20, 0xf1, 0x2f, 0xc2, 0x6d, 0x55, 0x18, 0x3d, 0xdb,
                0xdd, 0x28, 0xb5, 0x73, 0x42, 0x31, 0x11, 0x20, 0xf1, 0x2f, 0xc2, 0x6d, 0x55, 0x18, 0x3d, 0xdb];

    global u256 ctx;
    ctx = (32u8)[0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x01,
                 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00];

    #[secret] reg u256 k0 k1;
    #[public] reg u256 n0 n1;
    k0 = #VPBROADCAST_2u128([:u128 key_p]);
    k1 = #VPBROADCAST_2u128([:u128 key_p + 16]);
    n0 = #VPBROADCAST_2u128([:u128 nonce_p]);
    #declassify(n0);
    n1 = #VPBROADCAST_2u128([:u128 nonce_p + 16]);
    #declassify(n1);

    #[secret] reg u256 k0n0 k1n1 k0c0 k1c1;

    k0n0 = k0 ^ n0;
    k1n1 = k1 ^ n1;
    k0c0 = k0 ^ c0;
    k1c1 = k1 ^ c1;

    #[secret] reg u256[6] st;
    st[0] = k0n0;
    st[1] = k1n1;
    st[2] = c1;
    st[3] = c0;
    st[4] = k0c0;
    st[5] = k1c1;

    inline int i;
    for i = 0 to 4 {
        st[3] ^= ctx;
        st[5] ^= ctx;
        st = update(st, k0);
        st[3] ^= ctx;
        st[5] ^= ctx;
        st = update(st, k1);
        st[3] ^= ctx;
        st[5] ^= ctx;
        st = update(st, k0n0);
        st[3] ^= ctx;
        st[5] ^= ctx;
        st = update(st, k1n1);
    }
    return st;
}

#[ct = "secret × public × public × public × public × public -> secret"]
inline fn finalize(reg u256[6] st,
                   reg u64 tag_p, reg u8 tag_len,
                   reg u64 ad_len, reg u64 msg_len,
                   inline bool verify)
    -> reg u64
{
    reg u64 ret;
    ?{}, ret = #set0();

    stack u64[4] sizes;
    ad_len <<= 3;
    msg_len <<= 3;
    sizes[0] = ad_len;
    sizes[2] = ad_len;
    sizes[1] = msg_len;
    sizes[3] = msg_len;
    reg u256 t = st[3] ^ sizes[:u256 0];

    inline int i;
    for i = 0 to 7 {
        st = update(st, t);
    }

    if (tag_len == 16) {
        reg u256 tag256;
        tag256 = st[0] ^ st[1];
        tag256 ^= st[2];
        tag256 ^= st[3];
        tag256 ^= st[4];
        tag256 ^= st[5];

        reg u128 tag;
        tag = #VEXTRACTI128(tag256, 1);
        tag ^= (128u) tag256;

        if (verify) {
            reg u128 valid;
            valid = [:u128 tag_p];
            valid = #VPCMPEQ_2u64(valid, tag);
            ret = (64u)#MOVEMASK_16u8(valid);
            ret += 1;
            ret >>= 16;
            ret -= 1;
        } else {
            [:u128 tag_p] = tag;
        }
    } else {
        reg u256[2] tag256;
        tag256[0] = st[0] ^ st[1];
        tag256[1] = st[3] ^ st[4];
        tag256[0] ^= st[2];
        tag256[1] ^= st[5];

        reg u128[2] tag;
        tag[0] = #VEXTRACTI128(tag256[0], 1);
        tag[1] = #VEXTRACTI128(tag256[1], 1);
        tag[0] ^= (128u) tag256[0];
        tag[1] ^= (128u) tag256[1];

        if (verify) {
            reg u128[2] valid;
            valid[0] = [:u128 tag_p];
            valid[1] = [:u128 tag_p + 16];
            valid[0] = #VPCMPEQ_2u64(valid[0], tag[0]);
            valid[1] = #VPCMPEQ_2u64(valid[1], tag[1]);
            valid[0] &= valid[1];
            ret = (64u)#MOVEMASK_16u8(valid[0]);
            ret += 1;
            ret >>= 16;
            ret -= 1;
        } else {
            [:u128 tag_p] = tag[0];
            [:u128 tag_p + 16] = tag[1];
        }
    }
    for i = 0 to 6 {
        st[i] = 0;
    }
    return ret;
}

#[ct = "public -> secret"]
export fn _aegis256x2_encrypt(reg u64 params)
    -> reg u64
{
    #[public] reg u64 ct_p tag_p msg_p ad_p key_p nonce_p;
    #[public] stack u64 ad_len_ msg_len_;
    #[public] reg u8 tag_len;

    ct_p = [:u64 params + 8 * 0];
    #declassify(ct_p);
    // ignored: ct_len = [:u64 :u64 params + 8 * 1];
    tag_p = [:u64 params + 8 * 2];
    #declassify(tag_p);
    tag_len = [:u8 params + 8 * 3];
    #declassify(tag_len);
    msg_p = [:u64 params + 8 * 4];
    #declassify(msg_p);
    msg_len_ = [:u64 params + 8 * 5];
    #declassify(msg_len_);
    ad_p = [:u64 params + 8 * 6];
    #declassify(ad_p);
    ad_len_ = [:u64 params + 8 * 7];
    #declassify(ad_len_);
    key_p = [:u64 params + 8 * 8];
    #declassify(key_p);
    nonce_p = [:u64 params + 8 * 9];
    #declassify(nonce_p);

    #[secret] reg u256[6] st;
    st = init(key_p, nonce_p);

    // ad

    reg u64 full_blocks;
    full_blocks = ad_len_;
    full_blocks = full_blocks & -32;

    reg u64 i;
    ?{}, i = #set0();

    #[align] while (i < full_blocks) {
        st = absorb(st, [:u256 ad_p + i]);
        i += 32;
    }
    reg u64 left;
    left = ad_len_;
    left -= i;

    if (left > 0) {
        ad_p += i;

        stack u256[1] pad;
        reg u256 zero = #set0_256();
        pad[0] = zero;

        ?{}, i = #set0();
        while (i < left) {
            pad[:u8 i] = [:u8 ad_p + i];
            i += 1;
        }
        st = absorb(st, pad[0]);
    }

    // message

    full_blocks = msg_len_;
    full_blocks = full_blocks & -64;

    ?{}, i = #set0();
    #[align] while (i < full_blocks) {
        st, [:u256 ct_p + i] = enc(st, [:u256 msg_p + i]);
        st, [:u256 ct_p + i + 32] = enc(st, [:u256 msg_p + i + 32]);
        i += 64;
    }
    left = msg_len_;
    left -= i;
    if (left >= 32) {
        st, [:u256 ct_p + i] = enc(st, [:u256 msg_p + i]);
        left -= 32;
        i += 32;
    }
    if (left > 0) {
        msg_p += i;
        ct_p += i;

        stack u256[1] pad;
        reg u256 zero = #set0_256();
        pad[0] = zero;

        ?{}, i = #set0();
        while (i < left) {
            pad[:u8 i] = [:u8 msg_p + i];
            i += 1;
        }

        st, pad[0] = enc(st, pad[0]);

        ?{}, i = #set0();
        while (i < left) {
            [:u8 ct_p + i] = pad[:u8 i];
            i += 1;
        }
    }

    // finalize

    reg u64 ret = finalize(st, tag_p, tag_len, ad_len_, msg_len_, false);

    return ret;
}

#[ct = "public -> secret"]
export fn _aegis256x2_decrypt(reg u64 params)
    -> reg u64
{
    #[public] reg u64 ct_p tag_p msg_p ad_p key_p nonce_p;
    #[public] stack u64 ad_len_ ct_len_;
    #[public] reg u8 tag_len;

    ct_p = [:u64 params + 8 * 0];
    #declassify(ct_p);
    ct_len_ = [:u64 params + 8 * 1];
    #declassify(ct_len_);
    tag_p = [:u64 params + 8 * 2];
    #declassify(tag_p);
    tag_len = [:u8 params + 8 * 3];
    #declassify(tag_len);
    msg_p = [:u64 params + 8 * 4];
    #declassify(msg_p);
    // ignored: msg_len_ = [:u64 params + 8 * 5];
    ad_p = [:u64 params + 8 * 6];
    #declassify(ad_p);
    ad_len_ = [:u64 params + 8 * 7];
    #declassify(ad_len_);
    key_p = [:u64 params + 8 * 8];
    #declassify(key_p);
    nonce_p = [:u64 params + 8 * 9];
    #declassify(nonce_p);

    #[secret] reg u256[6] st;
    st = init(key_p, nonce_p);

    // ad

    reg u64 full_blocks;
    full_blocks = ad_len_;
    full_blocks = full_blocks & -32;

    reg u64 i;
    ?{}, i = #set0();
    #[align] while (i < full_blocks) {
        st = absorb(st, [:u256 ad_p + i]);
        i += 32;
    }
    reg u64 left;
    left = ad_len_;
    left -= i;

    if (left > 0) {
        ad_p += i;

        stack u256[1] pad;
        reg u256 zero = #set0_256();
        pad[0] = zero;

        ?{}, i = #set0();
        while (i < left) {
            pad[:u8 i] = [:u8 ad_p + i];
            i += 1;
        }

        st = absorb(st, pad[0]);
    }

    // ciphertext

    full_blocks = ct_len_;
    full_blocks = full_blocks & -64;

    ?{}, i = #set0();
    #[align] while (i < full_blocks) {
        #[public] reg u256 t;
        t = [:u256 ct_p + i];
        #declassify(t);
        st, [:u256 msg_p + i] = dec(st, t);
        t = [:u256 ct_p + i + 32];
        #declassify(t);
        st, [:u256 msg_p + i + 32] = dec(st, t);
        i += 64;
    }
    left = ct_len_;
    left -= i;
    if (left > 32) {
        #[public] reg u256 t;
        t = [:u256 ct_p + i];
        #declassify(t);
        st, [:u256 msg_p + i] = dec(st, t);
        left -= 32;
        i += 32;
    }
    if (left > 0) {
        msg_p += i;
        ct_p += i;

        #[flexible] stack u256[1] pad;
        reg u256 zero = #set0_256();
        pad[0] = zero;

        ?{}, i = #set0();
        while (i < left) {
            pad[:u8 i] = [:u8 ct_p + i];
            i += 1;
        }

        #[public] reg u256 t;
        t = pad[0];
        #declassify(t);

        st, pad[0] = declast(st, t, left);

        ?{}, i = #set0();
        while (i < left) {
            [:u8 msg_p + i] = pad[:u8 i];
            i += 1;
        }
    }

    // finalize

    reg u64 ret = finalize(st, tag_p, tag_len, ad_len_, ct_len_, true);

    return ret;
}
